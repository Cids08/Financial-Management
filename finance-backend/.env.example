APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2

# ── Cloudflare R2 (private object storage) ────────────────────────────────────
# Store every file (receipts, proofs, AP/AR/tax documents, budget plans,
# avatars, logos) in a PRIVATE R2 bucket. The bucket stays private — all
# reads are served as short-lived SIGNED URLs (Laravel temporaryUrl on the
# S3 driver). Nothing stored in R2 gets a stable public URL.
#
#  1. Cloudflare → R2 → Create bucket (keep it PRIVATE).
#  2. R2 → Manage R2 API Tokens → Create token with "Admin read & write"
#     permission (R2 Access Key + Secret).
#  3. R2_ACCOUNT_ID = your 32-char Cloudflare account id (visible in the
#     R2 dashboard URL). The S3-API endpoint is always
#     https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT=
R2_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=brevo
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo (formerly Sendinblue) SMTP relay — the app's actual transport:
# the app no longer uses PHPMailer; mailer "brevo" in config/mail.php is SMTP.
# Put your real values in the gitignored .env (never in this file):
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_ENCRYPTION=tls
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Web Push (VAPID) descriptors ─────────────────────────────────────────────
# Real key VALUES must go in the gitignored .env (never in this file), and the
# SAME pair must be set on HostForge so production pushes sign correctly.
# Generate a pair with:
#   openssl ecparam -name prime256v1 -genkey -noout
#   openssl ec -in <key> -text -noout   # take priv: and pub: hex
# then base64url-encode both halves (RFC 7517 raw point / raw scalar, no padding).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@fms.alibaton-ph.com
